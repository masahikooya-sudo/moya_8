# ---- Claude API ----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low / medium / high (FAQ回答は low〜medium で十分なことが多い)
CLAUDE_EFFORT=low

# ---- SharePoint (Microsoft Graph, アプリ専用認証) ----
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=
# 例: https://contoso.sharepoint.com/sites/faq
SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/faq

# ---- 同期・検索 ----
# 0 で自動同期を無効化(手動で python -m app.sync を実行)
SYNC_INTERVAL_MINUTES=60
# 1回の質問で参照するFAQチャンク数
SEARCH_TOP_K=8
# FAQ全体の文字数がこれ以下なら全文をプロンプトに入れる(検索漏れがなくなる)。0で常に検索モード
FULL_CONTEXT_MAX_CHARS=60000
DATA_DIR=data

# ---- 回答文面 ----
COMPANY_NAME=当社
# 回答できない時に案内する問い合わせ先
FALLBACK_CONTACT=総務部ヘルプデスク(内線 1234)
